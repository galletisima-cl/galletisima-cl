# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.codex-dev.log

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# Local deployment bundles and staging directories
.deploy-*/
.deploy-*.zip
.sites-*/
.sites-*.zip
.sites-*.tar.gz
.next-stale-*/

# Local audit/migration scratch files
.tmp-*/
.tmp-*.mjs
.tmp-*.txt
.devlog.txt
supabase/.temp/

# TypeScript incremental build cache
*.tsbuildinfo
